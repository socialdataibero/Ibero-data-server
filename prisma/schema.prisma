generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  ADMIN
  EDITOR
  MEMBER
}

enum DatasetVisibility {
  PUBLIC
  PRIVATE
}

// Catálogo cerrado de programas/encuestas, tomado de ckanext-duckdb
// (scheming/dataset_schema.yaml). "OTRA" cubre lo que no encaje.
enum Survey {
  ENIGH
  ENOE
  INPC
  ENADID
  ENVIPE
  CENSO
  ENDUTIH
  OTRA
}

enum PeriodType {
  ANNUAL
  QUARTERLY
  MONTHLY
  BIANNUAL
  ONE_TIME
  MULTIYEAR
}

enum AnalysisStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum AnalysisOrigin {
  IBERO
  VISTRACE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isSysadmin   Boolean  @default(false)
  isActive     Boolean  @default(true)
  /// Bumped on password change so tokens issued before it stop working (SDI-133).
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       OrganizationMember[]
  ownedDatasets     Dataset[]
  analyses          Analysis[]
  harmonizerSurveys HarmonizerSurvey[]
  harmonizerImports HarmonizerImport[]

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           OrganizationMember[]
  datasets          Dataset[]
  harmonizerSurveys HarmonizerSurvey[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_members")
}

model Dataset {
  id             String            @id @default(uuid())
  organizationId String
  ownerId        String
  title          String
  slug           String            @unique
  description    String?
  visibility     DatasetVisibility @default(PRIVATE)

  // ---- Clasificación temática (ckanext-duckdb dataset_schema.yaml) ----
  survey     Survey?
  year       Int?
  periodType PeriodType?

  // ---- Fuente y descubribilidad ----
  sourceOrg String?
  sourceUrl String?
  tags      String[] @default([])
  licenseId String?

  // ---- Versionado ----
  revision       Int       @default(1)
  revisionOfId   String?
  revisionOf     Dataset?  @relation("DatasetRevisions", fields: [revisionOfId], references: [id])
  revisions      Dataset[] @relation("DatasetRevisions")
  changelog      String?
  supersededById String?   @unique
  supersededBy   Dataset?  @relation("DatasetSupersession", fields: [supersededById], references: [id])
  supersedes     Dataset?  @relation("DatasetSupersession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id])
  resources    Resource[]
  analyses     Analysis[]

  @@map("datasets")
}

model Resource {
  id         String   @id @default(uuid())
  datasetId  String
  filename   String
  format     String
  sizeBytes  BigInt
  storageKey String
  /// Schema del parquet capturado al subir: [{ name, type }]. Se usa para
  /// poblar el selector de columnas del step-builder y validar el recipe
  /// antes de correrlo (igual que parquet_schema en ckanext-duckdb).
  columns    Json?
  createdAt  DateTime @default(now())

  dataset  Dataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  analyses Analysis[]

  @@map("resources")
}

/// Un análisis guardado: la "receta" (steps) + metadata + resultado
/// materializado a Parquet. Equivalente a los datasets `dataset_type: analysis`
/// de ckanext-duckdb, pero como entidad propia en vez de un Dataset completo
/// (no necesitábamos todo el aparato de organización/miembros para esto).
model Analysis {
  id               String            @id @default(uuid())
  datasetId        String
  sourceResourceId String
  title            String
  slug             String            @unique
  folder           String
  description      String?
  visibility       DatasetVisibility @default(PRIVATE)
  /// Los steps tal como los mandó el step-builder: [{ op, params }, ...]
  recipe           Json
  origin           AnalysisOrigin    @default(IBERO)
  vistraceRecipe   Json?
  status           AnalysisStatus    @default(PENDING)
  errorMessage     String?
  resultStorageKey String?
  resultRowCount   Int?
  /// [{ name, type }] del resultado, para poder mostrar la tabla sin releer el parquet.
  resultColumns    Json?
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  dataset        Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  sourceResource Resource @relation(fields: [sourceResourceId], references: [id])
  createdBy      User     @relation(fields: [createdById], references: [id])

  @@map("analyses")
}

// ---------------------------------------------------------------------------
// Armonizador de encuestas (portado de sectei-intermediario / FastAPI).
// Unifica columnas con nombres distintos entre ediciones (`age` 2020, `edad1`
// 2021) bajo un nombre canónico por encuesta. La vista armonizada NUNCA se
// materializa: se calcula al vuelo desde el Parquet crudo de cada edición
// (storage/harmonizer/<datasetId>.parquet) + mappings.
// Prefijo `Harmonizer` porque `Survey` (enum) y `Dataset` ya existen arriba.
// ---------------------------------------------------------------------------

model HarmonizerSurvey {
  id             String        @id @default(uuid())
  name           String        @unique
  description    String?
  createdAt      DateTime      @default(now())
  /// Owner (SDI-91): its ADMIN and EDITOR members may edit it. Null on surveys created before ownership; only the sysadmin edits those.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  datasets           HarmonizerDataset[]
  canonicalVariables HarmonizerCanonicalVariable[]
  codebooks          HarmonizerCodebook[]
  imports            HarmonizerImport[]

  @@map("harmonizer_surveys")
}

/// Una edición concreta de la encuesta (el CSV subido para un año).
model HarmonizerDataset {
  id            String   @id @default(uuid())
  surveyId      String
  name          String
  year          Int
  /// Encabezados del CSV en su orden original. Las columnas del Parquet crudo
  /// son posicionales (`c0`, `c1`, …): sus nombres reales salen de aquí.
  columns       String[] @default([])
  rowCount      Int      @default(0)
  createdAt     DateTime @default(now())
  /// Diccionario de variables que describe este archivo, y la tabla (hoja) de él
  /// que le corresponde. Borrar el diccionario deja la edición sin diccionario.
  codebookId    String?
  codebookTable String?
  /// How the source was collected: `census` (every unit enumerated) or `sample` (each record
  /// stands for several units and needs an expansion factor). Null on editions uploaded before
  /// it was asked.
  design        String?
  /// What each record is: `person`, `dwelling` or `household`. Null like `design`.
  unit          String?

  survey   HarmonizerSurvey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  codebook HarmonizerCodebook?       @relation(fields: [codebookId], references: [id], onDelete: SetNull)
  mappings HarmonizerMapping[]
  profiles HarmonizerColumnProfile[]
  columnChecks HarmonizerColumnCheck[]

  /// El nombre es `_dataset` en la vista por encuesta: debe ser único en ella.
  @@unique([surveyId, name])
  @@map("harmonizer_datasets")
}

/// Nombre canónico, único POR encuesta (no global): `edad` puede existir en
/// dos encuestas distintas como dos filas.
model HarmonizerCanonicalVariable {
  id                String    @id @default(uuid())
  surveyId          String
  name              String
  description       String?
  /// Tipo en el Parquet exportado: "text", "integer" o "decimal". `null` = sin
  /// confirmar: el export usa el tipo inferido de los valores.
  dataType          String?
  /// Catálogo de categorías: `[{ code, label }]` con los códigos comunes a los que
  /// se recodifican las ediciones. `null` = sin catálogo.
  categories        Json?
  /// Revisión de las diferencias de códigos entre ediciones («Revisada, es
  /// correcto»). Vale mientras las diferencias sigan siendo las mismas: la firma
  /// es un hash de ellas.
  reviewedSignature String?
  reviewedAt        DateTime?
  reviewedBy        String?

  survey   HarmonizerSurvey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  mappings HarmonizerMapping[]

  @@unique([surveyId, name])
  @@index([surveyId])
  @@map("harmonizer_canonical_variables")
}

/// "La columna `edad1` de este dataset corresponde a la canónica `edad`".
/// Clave (datasetId, sourceColumn): una columna se mapea a UNA canónica por
/// dataset, y cada dataset puede mapear la misma columna a canónicas distintas.
model HarmonizerMapping {
  id                  String   @id @default(uuid())
  datasetId           String
  sourceColumn        String
  canonicalVariableId String
  /// Códigos de no especificado de esta columna en esta edición (p. ej. 9, 99).
  /// En la vista armonizada se entregan como nulo, igual que las celdas vacías.
  missingCodes        String[] @default([])
  /// Recodificación de valores de esta columna: `{ "valor del archivo": "código común" }`.
  /// Se aplica después de los códigos de no especificado.
  valueMap            Json     @default("{}")
  /// Sample design role of this column: `weight` (expansion factor), `stratum` or `psu`
  /// (primary sampling unit). Only in sample editions, at most one column per role.
  role                String?

  dataset           HarmonizerDataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  canonicalVariable HarmonizerCanonicalVariable @relation(fields: [canonicalVariableId], references: [id], onDelete: Cascade)

  @@unique([datasetId, sourceColumn])
  @@index([datasetId])
  @@index([canonicalVariableId])
  @@map("harmonizer_mappings")
}

/// Diccionario de variables (descriptor) de una encuesta: describe las columnas de
/// uno o varios archivos y sus categorías. Se sube una vez y se aplica a varias
/// ediciones (por ejemplo, las 32 entidades de un censo).
model HarmonizerCodebook {
  id        String   @id @default(uuid())
  surveyId  String
  name      String
  /// Nombre del archivo subido, solo informativo.
  fileName  String
  /// "inegi" (descriptor .xls/.xlsx del INEGI) o "csv" (plantilla de la plataforma).
  format    String
  createdAt DateTime @default(now())

  survey    HarmonizerSurvey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  variables HarmonizerCodebookVariable[]
  datasets  HarmonizerDataset[]

  @@unique([surveyId, name])
  @@map("harmonizer_codebooks")
}

/// Una variable del diccionario. `table` es la hoja del descriptor (VIVIENDAS,
/// PERSONAS…) o "" en la plantilla CSV sin columna `tabla`.
model HarmonizerCodebookVariable {
  id           String  @id @default(uuid())
  codebookId   String
  table        String
  position     Int
  name         String
  label        String?
  question     String?
  section      String?
  /// "text", "integer" o "decimal" si el diccionario lo dice; si no, `null`.
  declaredType String?
  validRange   String?
  length       Int?
  /// `[{ code, label, kind }]`, `kind`: value, missing, blank, range o catalog.
  categories   Json    @default("[]")

  codebook HarmonizerCodebook @relation(fields: [codebookId], references: [id], onDelete: Cascade)

  @@unique([codebookId, table, name])
  @@index([codebookId])
  @@map("harmonizer_codebook_variables")
}

/// Valores distintos de una columna de una edición con su frecuencia. Los datos de
/// una edición no cambian, así que se calcula una vez (al subirla o la primera vez
/// que se necesita) y se reutiliza para comparar códigos entre ediciones.
model HarmonizerColumnProfile {
  id             String  @id @default(uuid())
  datasetId      String
  sourceColumn   String
  /// `[{ value, count }]`, valores recortados, del más frecuente al menos.
  values         Json
  /// Hay más valores distintos de los guardados.
  distinctCapped Boolean
  /// Celdas vacías o solo con espacios.
  empty          Int

  dataset HarmonizerDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, sourceColumn])
  @@map("harmonizer_column_profiles")
}

/// Result of one value check of an edition's column (`column-checks.ts`: suggested type, codes of
/// the dictionary), kept because an edition's data never changes. `key` is the SHA-256 of the
/// check's query, so different codes, or a change in the query itself, compute a new one.
model HarmonizerColumnCheck {
  datasetId String
  key       String
  /// The query's single row.
  result    Json
  createdAt DateTime @default(now())

  dataset HarmonizerDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@id([datasetId, key])
  @@map("harmonizer_column_checks")
}

enum HarmonizerImportStatus {
  /// The file is still arriving through tus.
  UPLOADING
  /// The file arrived and the job is queued.
  PENDING
  /// The worker is reading and converting it.
  PROCESSING
  COMPLETED
  FAILED
}

/// One upload of an edition through tus, from its first byte until the worker turns it into an
/// edition (or rejects it). Its id is also the tus upload id and the job id.
model HarmonizerImport {
  id             String                 @id
  status         HarmonizerImportStatus @default(UPLOADING)
  /// What the worker is doing: `checking` (encoding), `reading` (rows), `saving`.
  phase          String?
  /// Data rows read so far, updated while the worker reads.
  rowsRead       Int                    @default(0)
  /// Times the worker started it. A file that keeps stopping the worker fails after a few.
  attempts       Int                    @default(0)
  fileName       String
  fileSize       BigInt
  /// `csv`, `csv_gz` or `dbf`, from the file name.
  format         String
  /// Edition fields, as sent with the upload.
  name           String
  year           Int
  /// Existing survey; null when the upload creates one (`newSurveyName`, `organizationId`).
  surveyId       String?
  newSurveyName  String?
  organizationId String?
  /// DBF encoding choice (`auto`, …); null for CSV.
  encoding       String?
  /// Source design and unit of analysis of the edition, as sent with the upload.
  design         String?
  unit           String?
  createdById    String
  /// Set when the edition is created.
  datasetId      String?
  /// `{ datasetId, dataset, renamedColumns, source }`, as the upload response used to be.
  result         Json?
  /// `{ statusCode, code, message, params? }`, the same body a synchronous upload would answer.
  error          Json?
  createdAt      DateTime               @default(now())
  uploadedAt     DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?

  survey    HarmonizerSurvey? @relation(fields: [surveyId], references: [id], onDelete: SetNull)
  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("harmonizer_imports")
}
