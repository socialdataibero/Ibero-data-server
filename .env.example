
DATABASE_URL="postgresql://ibero:ibero@localhost:5433/ibero_data?schema=public"
JWT_SECRET=
PORT=3000
API_BASE_URL=http://localhost:3000
VISTRACE_URL=http://localhost:4201

SEED_ADMIN_EMAIL=admin@ibero.mx
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_NAME="Admin Ibero"

# Temporary: largest edition/survey (rows) the harmonizer downloads accept.
HARMONIZER_FULL_READ_MAX_ROWS=400000

# Background jobs (BullMQ). Redis from docker-compose.yml listens on host port 6380.
REDIS_URL=redis://localhost:6380
# Jobs a worker process runs at once.
WORKER_CONCURRENCY=1

# DuckDB in the worker process.
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4
# Where DuckDB spills to disk when a job does not fit in memory. Empty = <OS temp>/ibero-duckdb.
DUCKDB_TEMP_DIR=

# DuckDB in the API process, per query (each query opens its own DuckDB).
API_DUCKDB_MEMORY_LIMIT=2GB
API_DUCKDB_THREADS=4
# Where API queries spill to disk. Empty = <OS temp>/ibero-duckdb-api.
API_DUCKDB_TEMP_DIR=

# Harmonizer uploads (tus). Empty UPLOAD_DIR = storage/uploads.
UPLOAD_DIR=
UPLOAD_MAX_BYTES=10737418240
DBF_MAX_BYTES=209715200
UPLOAD_EXPIRATION_HOURS=24
